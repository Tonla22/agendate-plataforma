# Servidor
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Base de datos y autenticacion
DATABASE_URL=postgresql://usuario:contrasena@host:5432/agendate
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
JWT_TENANT_SECRET=reemplazar-por-otro-secreto-largo-y-aleatorio
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=reemplazar-por-una-contrasena-segura
ADMIN_NAME=Admin

# Mercado Pago OAuth
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CURRENCY=UYU
MERCADOPAGO_AUTH_URL=https://auth.mercadopago.com/authorization

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/comercio/google-calendar/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Cloud API (opcional durante la beta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_DEFAULT_COUNTRY_CODE=598
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_CONFIRMACION_TEMPLATE=confirmacion_reserva
WHATSAPP_RECORDATORIO_TEMPLATE=recordatorio_reserva
WHATSAPP_CANCELACION_TEMPLATE=cancelacion_reserva
WHATSAPP_AGRADECIMIENTO_TEMPLATE=agradecimiento_reserva
WHATSAPP_AUTOMATIONS_ENABLED=false
WHATSAPP_AUTOMATION_INTERVAL_MS=60000

# Automatizaciones externas
AUTOMATION_SECRET=
DISABLE_AUTOMATIONS=false
