# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/agendate

# JWT Secret (cambiá esto por una cadena larga aleatoria)
JWT_SECRET=cambiar_esto_por_algo_muy_secreto_y_largo

# Puerto del servidor
PORT=3000

# URL pública de la plataforma
BASE_URL=https://agendate.com

# Admin super (se crea al inicializar la DB)
ADMIN_EMAIL=admin@agendate.com
ADMIN_PASSWORD=cambiar_esto_tambien
