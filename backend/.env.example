# Servidor
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
# En producción pegás acá la URL de Neon / Render / Railway
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Seguridad JWT
# Generar una clave larga y privada
JWT_SECRET=poner_una_clave_larga_y_segura

# URL del frontend / dominio permitido
# En local:
FRONTEND_URL=http://localhost:3000

# URL pública de la app
BASE_URL=http://localhost:3000

# Datos iniciales de admin, solo si tus scripts los usan
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiar_esta_password
ADMIN_NAME=Admin